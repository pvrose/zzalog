{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "call",
                "${workspaceFolder}\\cmake\\build-debug.cmd"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "call",
                "${workspaceFolder}\\cmake\\build-release.cmd"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
