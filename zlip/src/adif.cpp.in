#pragma once

#include "adif.h"

/* adif.h.in
 * This file provides the structure definitions and function prototypes
 * for handling ADIF (Amateur Data Interchange Format) files.
 */

 #include <stdint.h>
 #include <map>
 #include <string>

 namespace adif {
	//! Map linking field enumeration values to their metadata
	static std::map<field_t, field_info_t> adif::FIELD_INFO_MAP = {
	@ZZALOG_ADIF_FIELD_INFO_MAP@
	{ FIELD_MAX, {"", "", ""} }
	};

	//! Map linking field names to their enumeration values
	static std::map<std::string, field_t> adif::FIELD_NAME_MAP = {
	@ZZALOG_ADIF_FIELD_NAME_MAP@
	{"", FIELD_MAX}
	};

	//! ADIF version string
	static char* VERSION = "@ZZALOG_ADIF_VERSION@";

}