#pragma once

/* adif.h.in
 * This file provides the structure definitions and function prototypes
 * for handling ADIF (Amateur Data Interchange Format) files.
 */

 #include <stdint.h>
 #include <map>
 #include <string>

 //! This namespace contains all ADIF related functionality.
 namespace adif {

  //! Enumeration for ADIF field names
  enum field_t : uint16_t {
    @ZZALOG_ADIF_FIELD_ENUM@
    FIELD_MAX
  };

  //! Structure providing metadata about an ADIF field
  struct field_info_t {
    const char* name;        //!< The name of the ADIF field
    const char* data_type;   //!< The data type
    const char* enum_type;   //!< The name of the enumeration type, if applicable
  };

  //! Map linking field enumeration values to their metadata
  extern std::map<field_t, field_info_t> FIELD_INFO_MAP;

  //! Map linking field names to their enumeration values
  extern std::map<std::string, field_t> FIELD_NAME_MAP;

  //! ADIF version string
  extern char* VERSION;

} // namespace adif